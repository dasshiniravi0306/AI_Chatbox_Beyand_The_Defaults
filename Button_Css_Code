/* ── Pulse animation on load to draw attention ──────────────── */
@keyframes ai-btn-pulse {
  0%   { box-shadow: 0 3px 12px rgba(232,80,58,0.4); }
  50%  { box-shadow: 0 3px 22px rgba(232,80,58,0.75); }
  100% { box-shadow: 0 3px 12px rgba(232,80,58,0.4); }
}

#ai-chat-btn,
.ai-chat-btn {
  animation: ai-btn-pulse 2.5s ease-in-out infinite !important;
}

/* Stop pulsing once hovered — feels cleaner */
#ai-chat-btn:hover,
.ai-chat-btn:hover {
  animation: none !important;
}
